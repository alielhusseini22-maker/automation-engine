# Anthropic Claude API (sourcing research + blog generation + caption writing)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (GPT-Image-1 for AI image generation)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Buffer (social posting Instagram + TikTok via unified API)
# Sign up at buffer.com, get token from Settings → Apps & Extras → Developers
BUFFER_ACCESS_TOKEN=

# Pexels (fallback stock video/photo content when queue is empty)
# Free API key: https://www.pexels.com/api/ — sign up and get the key in your dashboard
PEXELS_API_KEY=

# Default project to operate on (overridable via --project flag)
PROJECT=poils-precieux

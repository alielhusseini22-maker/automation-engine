{
  "$schema": "../_template/config.schema.json",
  "project": {
    "id": "poils-precieux",
    "name": "Poils Précieux",
    "domain": "poilsprecieux.com",
    "locale": "fr-FR",
    "currency": "EUR",
    "country": "FR"
  },
  "shopify": {
    "store": "t90uug-9b.myshopify.com",
    "envToken": "POILS_PRECIEUX_SHOPIFY_TOKEN",
    "blogId": "gid://shopify/Blog/121879003473"
  },
  "openai": {
    "envKey": "OPENAI_API_KEY",
    "imageQuality": "high",
    "imageModel": "gpt-image-1"
  },
  "anthropic": {
    "envKey": "ANTHROPIC_API_KEY",
    "model": "claude-opus-4-7"
  },
  "buffer": {
    "envToken": "POILS_PRECIEUX_BUFFER_TOKEN",
    "profiles": {
      "facebook": null,
      "instagram": null,
      "tiktok": null
    }
  },
  "aiVideo": {
    "enabled": false,
    "_comment": "Désactivé : qualité Hailuo/Ray Flash 2026 insuffisante. Réactiver quand Sora 2 / Veo 3 / Kling v3 atteignent la barre brand. Pexels stock = source primaire en attendant."
  },
  "sourcing": {
    "rules": {
      "minOrders": 500,
      "minRating": 4.0,
      "minPriceUSD": 3,
      "maxPriceUSD": 30,
      "targetMarginPct": 50,
      "maxDeliveryDays": 30,
      "categories": ["chien", "chat", "toilettage", "alimentation", "couchage", "balade", "jeu"],
      "excludeCategories": ["vêtements humour", "oiseaux", "poissons", "reptiles", "croquettes", "médicaments"]
    },
    "weeklyTargets": {
      "candidatesCount": 15,
      "minOrdersBatch": 500,
      "diversifyCategories": true
    },
    "rotation": [
      { "week": 1, "focus": "toilettage" },
      { "week": 2, "focus": "couchage" },
      { "week": 3, "focus": "alimentation" },
      { "week": 4, "focus": "balade" }
    ]
  },
  "polish": {
    "language": "fr",
    "renameColors": true,
    "removeShipsFrom": true,
    "alignPricesPerColor": true,
    "extractDimensionsToDescription": true,
    "simplifySingleVariantOption": true,
    "generateContentAI": true,
    "assignCollections": true,
    "maxColors": 6,
    "titlePattern": "[Nature] [Bénéfice] — [Mascotte]™",
    "handlePattern": "[nature]-[mascotte]"
  },
  "images": {
    "shotsPerColor": 1,
    "background": "transparent",
    "size": "1024x1024",
    "removeOldImages": true,
    "backupBeforeReplace": true
  },
  "blog": {
    "cadence": "weekly",
    "dayOfWeek": "wednesday",
    "publishTime": "09:00",
    "author": "Équipe Poils Précieux",
    "topicRotation": ["guide-pratique", "comparatif-produits", "saisonnier", "sante-conseil"],
    "wordsTarget": 1200,
    "wordsMin": 800,
    "wordsMax": 1500,
    "internalLinksPerArticle": 2
  },
  "social": {
    "cadence": "daily",
    "publishTime": "18:00",
    "platforms": ["facebook", "instagram", "tiktok"],
    "weeklySchedule": {
      "monday":    { "theme": "guide",             "format": "single", "source": "ai_or_queue",     "fallback": "skip" },
      "tuesday":   { "theme": "produit",           "format": "single", "source": "shopify_product", "fallback": "ai_image" },
      "wednesday": { "theme": "tendresse",         "format": "reel",   "source": "queue",           "fallback": "pexels" },
      "thursday":  { "theme": "cas-usage-produit", "format": "single", "source": "shopify_product", "fallback": "ai_image" },
      "friday":    { "theme": "communaute",        "format": "single", "source": "ai_or_queue",     "fallback": "skip" },
      "saturday":  { "theme": "behind-scenes",     "format": "reel",   "source": "queue",           "fallback": "pexels" },
      "sunday":    { "theme": "inspiration",       "format": "reel",   "source": "queue",           "fallback": "pexels" }
    },
    "hashtagsCore": ["#poilsprecieux", "#poilsprecieuxfr"],
    "hashtagsHighVolumeFR": [
      "#chien", "#chat", "#chienenfrance", "#chatenfrance", "#petlovers", "#petlife", "#animauxfr"
    ],
    "hashtagsCategoryPool": {
      "chien": [
        "#chienpremium", "#brossagechien", "#santechien", "#chiendebonheur",
        "#toilettagechien", "#educationcanine", "#chiothiver", "#chiensenior",
        "#poilslongs", "#poilscourts", "#shibainu", "#cockerspaniel", "#goldenretriever",
        "#bergerallemand", "#labrador", "#frenchie", "#bichonfrise", "#cavalierkingcharles"
      ],
      "chat": [
        "#chataccessoire", "#brossagechat", "#santechat", "#chatpoilus",
        "#toilettagechat", "#chathaut", "#maincoon", "#chatpersan", "#chatbritish",
        "#chatonmignons", "#chatsiamois", "#chatcalico", "#chatsdomestiques"
      ],
      "toilettage": [
        "#toilettage", "#toilettagechien", "#toilettagechat", "#brossage", "#pelagetip"
      ],
      "couchage": [
        "#litpourchien", "#litpourchat", "#couchageanimal", "#cocooning"
      ],
      "balade": [
        "#promenadechien", "#harnaischien", "#laissechien", "#chienenballade"
      ]
    },
    "hashtagsCommunity": [
      "#dogsofinstagram", "#catsofinstagram", "#dogsofparis", "#catsofparis",
      "#instadog", "#instacat", "#pawsome"
    ]
  }
}
